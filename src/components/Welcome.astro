---
const sections = [
	{
		icon: "📚",
		title: "الكتب",
		description: "ملخصات الكتب والفوائد والأفكار المهمة",
		link: "/books",
	},
	{
		icon: "🧠",
		title: "المعرفة",
		description: "مقالات ومعلومات منظمة في مختلف المجالات",
		link: "/knowledge",
	},
	{
		icon: "🎵",
		title: "الأناشيد والقصائد",
		description: "كلمات الأناشيد والقصائد في مكان مرتب",
		link: "/nasheeds",
	},
	{
		icon: "📂",
		title: "الملفات",
		description: "ملفات ومصادر مفيدة قابلة للتحميل والتصفح",
		link: "/files",
	},
];
---

<header class="site-header">
	<div class="container nav">
		<a class="brand" href="/">العلامات</a>

		<nav>
			<a href="/">الرئيسية</a>
			<a href="/books">الكتب</a>
			<a href="/knowledge">المعرفة</a>
			<a href="/nasheeds">الأناشيد</a>
			<a href="/files">الملفات</a>
		</nav>

		<button id="themeButton" class="theme-button" aria-label="تغيير المظهر">🌙</button>
	</div>
</header>

<main>
	<section class="hero">
		<div class="container hero-content">
			<span class="label">موسوعة عربية منظمة</span>

			<h1>كل معرفة تترك علامة</h1>

			<p>
				منصة عربية تجمع الكتب والمعلومات والمقالات والأناشيد والملفات
				بطريقة مرتبة وسهلة وسريعة
			</p>

			<div class="search">
				<input
					type="search"
					placeholder="ابحث عن كتاب أو معلومة أو موضوع"
					aria-label="البحث"
				/>
				<button>بحث</button>
			</div>

			<div class="hero-actions">
				<a class="primary-button" href="#sections">استكشف الموسوعة</a>
				<a class="secondary-button" href="/books">ابدأ بالكتب</a>
			</div>
		</div>
	</section>

	<section id="sections" class="content-section">
		<div class="container">
			<div class="section-heading">
				<span class="label">تصفح بسهولة</span>
				<h2>أقسام الموسوعة</h2>
				<p>اختر القسم الذي تريد البدء منه</p>
			</div>

			<div class="cards">
				{
					sections.map((section) => (
						<a class="card" href={section.link}>
							<div class="icon">{section.icon}</div>
							<h3>{section.title}</h3>
							<p>{section.description}</p>
							<span>تصفح القسم ←</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="vision-section">
		<div class="container vision-box">
			<div>
				<span class="label">رؤية العلامات</span>
				<h2>معرفة مرتبة بدلًا من البحث المشتت</h2>
				<p>
					هدفنا بناء موسوعة عربية أوضح وأسهل تنظيمًا من الموسوعات التقليدية
				</p>
			</div>

			<a class="primary-button" href="#sections">ابدأ الآن</a>
		</div>
	</section>
</main>

<footer>
	<div class="container footer-content">
		<div>
			<strong>العلامات</strong>
			<p>موسوعة عربية للمعرفة والمحتوى المفيد</p>
		</div>

		<div class="footer-links">
			<a href="/">الرئيسية</a>
			<a href="/books">الكتب</a>
			<a href="/knowledge">المعرفة</a>
			<a href="/nasheeds">الأناشيد</a>
		</div>
	</div>
</footer>

<script>
	const button = document.getElementById("themeButton");

	if (localStorage.getItem("theme") === "dark") {
		document.body.classList.add("dark");
	}

	button?.addEventListener("click", () => {
		document.body.classList.toggle("dark");

		localStorage.setItem(
			"theme",
			document.body.classList.contains("dark") ? "dark" : "light"
		);
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(255, 255, 255, 0.92);
		border-bottom: 1px solid var(--border);
		backdrop-filter: blur(14px);
	}

	:global(body.dark) .site-header {
		background: rgba(15, 23, 42, 0.92);
	}

	.nav {
		min-height: 72px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.brand {
		color: var(--primary);
		font-size: 1.55rem;
		font-weight: 900;
	}

	nav {
		display: flex;
		gap: 24px;
	}

	nav a:hover {
		color: var(--primary);
	}

	.theme-button {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		border: 1px solid var(--border);
		background: var(--surface);
		cursor: pointer;
	}

	.hero {
		min-height: 620px;
		display: grid;
		place-items: center;
		text-align: center;
		background:
			radial-gradient(circle at top right, #dbeafe 0, transparent 38%),
			linear-gradient(180deg, #ffffff 0%, var(--bg) 100%);
	}

	.hero-content {
		max-width: 900px;
		padding-top: 70px;
		padding-bottom: 70px;
	}

	.label {
		display: inline-block;
		padding: 7px 14px;
		border-radius: 999px;
		background: #dbeafe;
		color: #1d4ed8;
		font-weight: 800;
		font-size: 0.9rem;
	}

	h1 {
		margin: 20px 0;
		font-size: clamp(3rem, 8vw, 6rem);
		line-height: 1.15;
	}

	.hero p {
		max-width: 720px;
		margin: auto;
		font-size: 1.18rem;
		color: #64748b;
	}

	.search {
		max-width: 700px;
		margin: 32px auto 20px;
		padding: 8px;
		display: flex;
		gap: 8px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 18px;
		box-shadow: 0 20px 55px rgba(15, 23, 42, 0.1);
	}

	.search input {
		flex: 1;
		padding: 13px;
		border: 0;
		outline: 0;
		background: transparent;
		font: inherit;
		color: inherit;
	}

	.search button,
	.primary-button {
		padding: 13px 22px;
		border: 0;
		border-radius: 12px;
		background: var(--primary);
		color: white;
		font-weight: 800;
		cursor: pointer;
	}

	.hero-actions {
		display: flex;
		justify-content: center;
		gap: 12px;
		flex-wrap: wrap;
	}

	.secondary-button {
		padding: 12px 22px;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--surface);
		font-weight: 800;
	}

	.content-section,
	.vision-section {
		padding: 90px 0;
	}

	.section-heading {
		text-align: center;
		margin-bottom: 38px;
	}

	.section-heading h2,
	.vision-box h2 {
		margin: 14px 0 8px;
		font-size: clamp(2rem, 5vw, 3rem);
	}

	.section-heading p,
	.vision-box p,
	.card p,
	footer p {
		color: #64748b;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
	}

	.card {
		padding: 30px;
		border: 1px solid var(--border);
		border-radius: 22px;
		background: var(--surface);
		box-shadow: 0 15px 40px rgba(15, 23, 42, 0.06);
		transition: 0.25s;
	}

	.card:hover {
		transform: translateY(-6px);
		border-color: var(--primary);
	}

	.icon {
		font-size: 2.7rem;
	}

	.card h3 {
		margin: 16px 0 8px;
		font-size: 1.25rem;
	}

	.card span {
		display: inline-block;
		margin-top: 18px;
		color: var(--primary);
		font-weight: 800;
	}

	.vision-box {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
		padding: 45px;
		border-radius: 28px;
		background: #0f172a;
		color: white;
	}

	footer {
		padding: 42px 0;
		border-top: 1px solid var(--border);
		background: var(--surface);
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		gap: 30px;
	}

	.footer-links {
		display: flex;
		gap: 20px;
		flex-wrap: wrap;
	}

	:global(body.dark) {
		--bg: #0b1220;
		--surface: #111c30;
		--text: #f8fafc;
		--border: #26344b;
		background: var(--bg);
		color: var(--text);
	}

	:global(body.dark) .hero {
		background:
			radial-gradient(circle at top right, #172554 0, transparent 38%),
			linear-gradient(180deg, #0f172a 0%, var(--bg) 100%);
	}

	@media (max-width: 900px) {
		.cards {
			grid-template-columns: repeat(2, 1fr);
		}

		nav {
			display: none;
		}
	}

	@media (max-width: 600px) {
		.cards {
			grid-template-columns: 1fr;
		}

		.search {
			flex-direction: column;
		}

		.vision-box,
		.footer-content {
			flex-direction: column;
			text-align: center;
		}

		h1 {
			font-size: 3rem;
		}
	}
</style>