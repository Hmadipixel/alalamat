---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
interface Props { title?: string; description?: string; }
const { title = "العلامات | موسوعة عربية منظمة", description = "العلامات موسوعة عربية للكتب والمعرفة والأناشيد والملفات" } = Astro.props;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<link rel="icon" href="/favicon.svg" />
<title>{title}</title>
<script is:inline>if(localStorage.getItem("theme")==="dark")document.documentElement.classList.add("dark-ready");</script>
</head>
<body>
<Header />
<main><slot /></main>
<Footer />
<script is:inline>if(document.documentElement.classList.contains("dark-ready"))document.body.classList.add("dark");</script>
</body>
</html>
