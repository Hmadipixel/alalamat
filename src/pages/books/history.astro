---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="التاريخ | العلامات" description="مدخل يساعد على قراءة التاريخ كأسباب ونتائج لا كتواريخ فقط.">
  <section class="hero"><div class="container"><span class="eyebrow">الكتب</span><h1>التاريخ</h1><p>مدخل يساعد على قراءة التاريخ كأسباب ونتائج لا كتواريخ فقط.</p></div></section>
  <section class="section"><div class="container article"><div class="note"><h2>لماذا ندرس التاريخ؟</h2><p>لفهم كيف تشكلت المجتمعات والدول والأفكار والاستفادة من نتائج القرارات السابقة.</p></div><div class="note"><h2>اقرأ السياق</h2><p>لا تفصل الحدث عن زمانه ومكانه والظروف الاقتصادية والسياسية والاجتماعية المحيطة به.</p></div><div class="note"><h2>قارن المصادر</h2><p>كلما كان الموضوع مهمًا فالأفضل مقارنة أكثر من مصدر والتمييز بين الخبر والتفسير.</p></div></div></section>
</Layout>
<style>.hero{padding:72px 0;text-align:center;background:linear-gradient(180deg,var(--surface),var(--bg))}.hero h1{font-size:clamp(2.5rem,7vw,4.6rem);margin:12px 0}.hero p{max-width:760px;margin:auto;color:var(--muted)}.article{max-width:850px}.article :global(.note){padding:24px;margin-bottom:18px;background:var(--surface);border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow)}.article :global(h2){margin-top:0}.article :global(p){color:var(--muted);margin-bottom:0}.article :global(ul){padding-right:22px}</style>
