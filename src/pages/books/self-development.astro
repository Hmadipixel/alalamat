---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="تطوير الذات | العلامات" description="أفكار أساسية تساعد على التحسن المستمر دون تعقيد.">
  <section class="hero"><div class="container"><span class="eyebrow">الكتب</span><h1>تطوير الذات</h1><p>أفكار أساسية تساعد على التحسن المستمر دون تعقيد.</p></div></section>
  <section class="section"><div class="container article"><div class="note"><h2>قاعدة التحسن الصغير</h2><p>التحسن المستمر ولو بخطوات صغيرة يجعل التقدم أسهل في المحافظة عليه من التغييرات الكبيرة المفاجئة.</p></div><div class="note"><h2>العادات</h2><p>ابدأ بسلوك بسيط وواضح واربطه بوقت أو موقف ثابت ثم كرره حتى يصبح جزءًا من يومك.</p></div><div class="note"><h2>التعلم</h2><p>الفهم ثم التطبيق ثم المراجعة المتباعدة أفضل من القراءة المتكررة بلا اختبار للنفس.</p></div></div></section>
</Layout>
<style>.hero{padding:72px 0;text-align:center;background:linear-gradient(180deg,var(--surface),var(--bg))}.hero h1{font-size:clamp(2.5rem,7vw,4.6rem);margin:12px 0}.hero p{max-width:760px;margin:auto;color:var(--muted)}.article{max-width:850px}.article :global(.note){padding:24px;margin-bottom:18px;background:var(--surface);border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow)}.article :global(h2){margin-top:0}.article :global(p){color:var(--muted);margin-bottom:0}.article :global(ul){padding-right:22px}</style>
