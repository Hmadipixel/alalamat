---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
const categories = [
  {icon:"🖋️",title:"القصائد",description:"قصائد مرتبة حسب الشاعر والتصنيف",href:`${base}literature/`,label:"فتح القصائد"},
  {icon:"🎵",title:"الأناشيد",description:"مكتبة لكلمات الأناشيد والمحتوى الإنشادي",href:`${base}nasheeds/words/`,label:"فتح الأناشيد"},
  {icon:"🎧",title:"استمع",description:"فهرس للمحتويات الصوتية المرتبطة بالموقع",href:`${base}nasheeds/listen/`,label:"فتح قسم الاستماع"},
  {icon:"📚",title:"المؤلفات",description:"فهرس للأعمال حسب المؤلف أو الشاعر",href:`${base}nasheeds/authors/`,label:"فتح المؤلفات"}
];
---
<Layout title="الأناشيد والقصائد | العلامات" description="تصفح الأناشيد والقصائد والمحتويات المرتبطة بها.">
<section class="hero"><div class="container"><span class="eyebrow">العلامات</span><h1>الأناشيد والقصائد</h1><p>الأدب والكلمة والصوت في مكان واحد</p></div></section>
<section class="section"><div class="container categories">{categories.map((item)=><a class="category-card" href={item.href}><div class="icon">{item.icon}</div><h2>{item.title}</h2><p>{item.description}</p><span>{item.label} ←</span></a>)}</div></section>
</Layout>
<style>.hero{padding:90px 0 65px;text-align:center;background:linear-gradient(135deg,var(--surface-2),var(--bg));border-bottom:1px solid var(--border)}.hero h1{margin:14px 0 5px;font-size:clamp(2.7rem,7vw,4.8rem)}.hero p{margin:0;color:var(--muted);font-size:1.1rem}.categories{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.category-card{padding:34px 25px;text-align:center;background:var(--surface);border:1px solid var(--border);border-radius:22px;box-shadow:var(--shadow);transition:transform .2s ease,border-color .2s ease}.category-card:hover{transform:translateY(-7px);border-color:var(--primary)}.icon{font-size:3rem}.category-card h2{margin:14px 0 6px}.category-card p{min-height:58px;color:var(--muted)}.category-card span{color:var(--primary);font-weight:800}@media(max-width:950px){.categories{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.categories{grid-template-columns:1fr}}
</style>
