---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="المراجع | العلامات" description="فهرس مخصص لتوثيق المصادر والوثائق المستخدمة في محتوى الموقع.">
  <section class="hero"><div class="container"><span class="eyebrow">الملفات</span><h1>المراجع</h1><p>فهرس مخصص لتوثيق المصادر والوثائق المستخدمة في محتوى الموقع.</p></div></section>
  <section class="section"><div class="container article"><div class="note"><h2>لماذا نوثق؟</h2><p>التوثيق يسهّل الرجوع إلى أصل المعلومة ويزيد من موثوقية المحتوى.</p></div><div class="note"><h2>ما الذي سيظهر هنا؟</h2><p>اسم المصدر ونوعه والموضوع المرتبط به ورابطه عند توفر رابط عام صالح.</p></div></div></section>
</Layout>
<style>.hero{padding:72px 0;text-align:center;background:linear-gradient(180deg,var(--surface),var(--bg))}.hero h1{font-size:clamp(2.5rem,7vw,4.6rem);margin:12px 0}.hero p{max-width:760px;margin:auto;color:var(--muted)}.article{max-width:850px}.article :global(.note){padding:24px;margin-bottom:18px;background:var(--surface);border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow)}.article :global(h2){margin-top:0}.article :global(p){color:var(--muted);margin-bottom:0}.article :global(ul){padding-right:22px}</style>
