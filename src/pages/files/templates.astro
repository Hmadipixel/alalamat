---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="القوالب | العلامات" description="مكان للقوالب الجاهزة التي تسهّل الدراسة والتلخيص والتنظيم.">
  <section class="hero"><div class="container"><span class="eyebrow">الملفات</span><h1>القوالب</h1><p>مكان للقوالب الجاهزة التي تسهّل الدراسة والتلخيص والتنظيم.</p></div></section>
  <section class="section"><div class="container article"><div class="note"><h2>قالب تلخيص</h2><p>العنوان ثم الفكرة الرئيسية ثم أهم النقاط ثم الفوائد ثم ما الذي سأطبقه.</p></div><div class="note"><h2>قالب مشروع</h2><p>الهدف ثم الخطوات ثم المسؤول ثم الموعد ثم الحالة ثم الملاحظات.</p></div></div></section>
</Layout>
<style>.hero{padding:72px 0;text-align:center;background:linear-gradient(180deg,var(--surface),var(--bg))}.hero h1{font-size:clamp(2.5rem,7vw,4.6rem);margin:12px 0}.hero p{max-width:760px;margin:auto;color:var(--muted)}.article{max-width:850px}.article :global(.note){padding:24px;margin-bottom:18px;background:var(--surface);border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow)}.article :global(h2){margin-top:0}.article :global(p){color:var(--muted);margin-bottom:0}.article :global(ul){padding-right:22px}</style>
