---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="الجداول | العلامات" description="نماذج بسيطة للجداول التي تساعد على المتابعة والتنظيم.">
  <section class="hero"><div class="container"><span class="eyebrow">الملفات</span><h1>الجداول</h1><p>نماذج بسيطة للجداول التي تساعد على المتابعة والتنظيم.</p></div></section>
  <section class="section"><div class="container article"><div class="note"><h2>جدول متابعة</h2><p>المهمة | الأولوية | الموعد | الحالة | الخطوة التالية.</p></div><div class="note"><h2>جدول تعلم</h2><p>الموضوع | ما فهمته | ما يحتاج مراجعة | التطبيق | تاريخ المراجعة القادمة.</p></div></div></section>
</Layout>
<style>.hero{padding:72px 0;text-align:center;background:linear-gradient(180deg,var(--surface),var(--bg))}.hero h1{font-size:clamp(2.5rem,7vw,4.6rem);margin:12px 0}.hero p{max-width:760px;margin:auto;color:var(--muted)}.article{max-width:850px}.article :global(.note){padding:24px;margin-bottom:18px;background:var(--surface);border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow)}.article :global(h2){margin-top:0}.article :global(p){color:var(--muted);margin-bottom:0}.article :global(ul){padding-right:22px}</style>
