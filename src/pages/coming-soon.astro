---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="قريبًا | العلامات"
  description="هذا القسم قيد الإعداد وسيتم إضافة المحتوى قريبًا."
>
  <section class="soon">
    <div class="container">
      <div class="card">
        <div class="icon">🚧</div>
        <h1>قريبًا</h1>
        <p>هذا القسم قيد الإعداد وسيتم إضافة المحتوى قريبًا إن شاء الله.</p>

        <a class="btn" href={import.meta.env.BASE_URL}>
          العودة إلى الرئيسية
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
.soon{
  min-height:70vh;
  display:grid;
  place-items:center;
  padding:60px 20px;
}

.card{
  max-width:650px;
  margin:auto;
  text-align:center;
  padding:50px 30px;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:24px;
  box-shadow:var(--shadow);
}

.icon{
  font-size:4rem;
}

h1{
  font-size:3rem;
  margin:15px 0 10px;
}

p{
  color:var(--muted);
  font-size:1.1rem;
  line-height:1.9;
}

.btn{
  display:inline-block;
  margin-top:25px;
  padding:12px 24px;
  border-radius:12px;
  background:var(--primary);
  color:white;
  font-weight:800;
}
</style>