---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
---

<Layout title="القصائد | العلامات">
  <section class="hero">
    <div class="container">
      <span class="eyebrow">الأدب العربي</span>
      <h1>القصائد</h1>
      <p>تصفح القصائد العربية واقرأها بسهولة</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="poems-grid">

        <a class="poem-card" href={`${base}burda/`}>
          <div class="icon">📜</div>
          <h2>قصيدة البردة</h2>
          <p>للإمام شرف الدين البوصيري</p>
          <span>قراءة القصيدة ←</span>
        </a>

      </div>
    </div>
  </section>
</Layout>

<style>
.hero {
  padding: 90px 0 60px;
  text-align: center;
  background: linear-gradient(135deg, var(--surface-2), var(--bg));
  border-bottom: 1px solid var(--border);
}

.hero h1 {
  margin: 12px 0 4px;
  font-size: clamp(2.5rem, 7vw, 4rem);
}

.hero p {
  color: var(--muted);
}

.poems-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.poem-card {
  padding: 32px;
  text-align: center;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 22px;
  box-shadow: var(--shadow);
  transition: transform .2s ease;
}

.poem-card:hover {
  transform: translateY(-6px);
}

.icon {
  font-size: 3rem;
}

.poem-card h2 {
  margin: 15px 0 5px;
}

.poem-card p {
  color: var(--muted);
}

.poem-card span {
  color: var(--primary);
  font-weight: 800;
}

@media(max-width:800px) {
  .poems-grid {
    grid-template-columns: 1fr;
  }
}
</style>